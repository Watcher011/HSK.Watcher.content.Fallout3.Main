<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  
  
  <ThingDef ParentName="SK_PlantFoodRawBase">
    <defName>RawMutfruit</defName>
    <label>raw Mutfruit</label>
    <description>Raw Mutfruit is a highly mutated fruit that grows in small villages. What kind of fruit that has mutated is unknown. Widely distributed in the Commonwealth, and also because of its abilities. Can be grown in friendly settlements. Used to prepare various dishes.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <texPath>Things/Item/MutfruitRAW</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1.1</MarketValue>
    </statBases>
    <ingestible>
		<foodType>VegetableOrFruit</foodType>
		<ingestEffect>EatVegetarian</ingestEffect>
		 <preferability>MealTerrible</preferability>
    </ingestible>
	<thingCategories>
	        <li>BasicPlantFoodRaw</li>
	</thingCategories>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">Fungus</li>
      </mergeCompatibilityTags>
    </ingredient>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>30</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>
  
  
  
   <ThingDef ParentName="SK_PlantFoodRawBase">
    <defName>RawPrickeye</defName>
    <label>raw Prickeye</label>
    <description>Raw Prickeye is a genetically unstable fruit that proliferates in irradiated urban ruins. Its original botanical lineage has been lost to radiation-induced mutation cycles. Commonly scavenged throughout the Commonwealth due to its rapid growth cycle and resilience to environmental toxins. Can be cultivated in secure settlements with sufficient radiation shielding. Primarily used in brewing and as a base for wasteland survival rations.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <texPath>Things/Item/RawPrickeye</texPath>
    </graphicData>
    <statBases>
      <MarketValue>2.1</MarketValue>
    </statBases>
    <ingestible>
		<foodType>VegetableOrFruit</foodType>
		<ingestEffect>EatVegetarian</ingestEffect>
		 <preferability>MealTerrible</preferability>
    </ingestible>
	<thingCategories>
	        <li>BasicPlantFoodRaw</li>
	</thingCategories>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">Fungus</li>
      </mergeCompatibilityTags>
    </ingredient>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>70</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

