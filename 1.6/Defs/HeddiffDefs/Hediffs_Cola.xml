<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>GoodNukaCola</defName>
		<label>Energy of the atom.</label>
		<description>Had some Cola.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<initialSeverity>2</initialSeverity>
		<isBad>false</isBad>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.7</severityPerDay>
			</li>
		</comps>
		<stages>
			<li>
				<minSeverity>0</minSeverity>
				<label>Refreshing</label>
				<painFactor>0.9</painFactor>
				<capMods>

					<li>
						<capacity>Consciousness</capacity>
						<offset>0.20</offset>
					</li>
					<li>
						<capacity>BloodFiltration</capacity>
						<offset>0.30</offset>
					</li>

				</capMods>
			</li>
			<li>
				<minSeverity>0.5</minSeverity>
				<label>Energy Drink, Feling Better.</label>
				<painFactor>0.8</painFactor>
				<capMods>

					<li>
						<capacity>Consciousness</capacity>
						<offset>0.25</offset>
					</li>
					<li>
						<capacity>BloodFiltration</capacity>
						<offset>0.40</offset>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>


    <HediffDef>
    <defName>MysteriousInfection</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.8, 0.35)</defaultLabelColor>
    <description>Sleeper agent</description>
    <label>Sleeper agent</label>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>
          <min>120000</min>  <!-- 2 дня -->
          <max>360000</max>  <!-- 6 дней -->
        </disappearsAfterTicks>
      </li>
      <li Class="Watcher.Events.HediffCompProperties_SleeperAgent"/>
    </comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>
</Defs>