                    </weaponTags>
                    <magazineCount>
                        <min>2</min>
                        <max>4</max>
                    </magazineCount>
                </li>
            </sidearms>
        </li>
    </modExtensions>
</PawnKindDef>

<PawnKindDef ParentName="InstituteCourserBase">
