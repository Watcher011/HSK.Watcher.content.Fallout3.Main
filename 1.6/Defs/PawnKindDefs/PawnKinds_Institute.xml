<Defs>


   <PawnKindDef Abstract="True" Name="InstituteBase">
    <race>ChjAndroid</race>
    <defaultFactionType>Institute</defaultFactionType>
    <backstoryFilters>
        <li>
            <categories>
                <li>Institute</li>
            </categories>
        </li>
    </backstoryFilters>
    <backstoryCryptosleepCommonality>0.1</backstoryCryptosleepCommonality>
    <isFighter>true</isFighter>
    <chemicalAddictionChance>0.05</chemicalAddictionChance>
    <itemQuality>Normal</itemQuality>
    <invNutrition>2.5</invNutrition>
    <invFoodDef>MealFine</invFoodDef>
    <minGenerationAge>20</minGenerationAge>
    <maxGenerationAge>50</maxGenerationAge>
	<apparelColor>(0,255,255)</apparelColor>
    <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <gearHealthRange>
        <min>0.6</min>
        <max>1.8</max>
    </gearHealthRange>
    <specificApparelRequirements>
        <li>
            <bodyPartGroup>Torso</bodyPartGroup>
            <apparelLayer>Shell</apparelLayer>
        </li>
    </specificApparelRequirements>
    <disallowedTraits>
        <li>Brawler</li>
        <li>Pyromaniac</li>
    </disallowedTraits>
    <requiredWorkTags>
        <li>Violent</li>
    </requiredWorkTags>
    <techHediffsMoney>
        <min>8000</min>
        <max>15000</max>
    </techHediffsMoney>
    <techHediffsTags>
        <li>Futuristic</li>
        <li>Military</li>
		<li>ImplantEmpireCommon</li>
    </techHediffsTags>
	 
    <techHediffsChance>0.9</techHediffsChance>
    <techHediffsMaxAmount>8</techHediffsMaxAmount>
   
</PawnKindDef>

<!-- Institute Courser -->
<PawnKindDef Name="InstituteCourserBase" ParentName="InstituteBase" Abstract="True">
    <label>Institute Courser</label>
    <combatPower>420</combatPower>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <gearHealthRange>
        <min>0.6</min>
        <max>1.8</max>
    </gearHealthRange>
    <apparelMoney>
        <min>12000</min>
        <max>18000</max>
    </apparelMoney>
    <apparelRequired>
		<li>Apparello_PipBoy</li>
    	<li>Apparello_Vaultjumpsuit</li>
        <li>Apparel_PowerArmorHelmet</li>
        <li>Apparel_PowerArmor</li>
    </apparelRequired>
    <apparelTags>
        <li>EnclaveStandard</li>
        <li>PowerArmor</li>
    </apparelTags>
    <weaponMoney>
        <min>2500</min>
        <max>4000</max>
    </weaponMoney>
    <weaponTags>
            <li>RF4</li>
            <li>AdvancedGun</li>
			<li>IndustrialGunAdvanced</li>
            <li>TierThreeRifle</li>
            <li>CE_AI_Rifle</li>
    </weaponTags>
    <skills>
        <li>
            <skill>Shooting</skill>
            <range>6~18</range>
        </li>
    </skills>
    <initialWillRange>3~5</initialWillRange>
    <initialResistanceRange>15~22</initialResistanceRange>
    <modExtensions>
        <li Class="CombatExtended.LoadoutPropertiesExtension">
            <primaryMagazineCount>
                <min>5</min>
                <max>7</max>
            </primaryMagazineCount>
            <sidearms>
                <li>
                    <generateChance>0.2</generateChance>
                    <sidearmMoney>
                        <min>300</min>
                        <max>500</max>
                    </sidearmMoney>
                    <weaponTags>
