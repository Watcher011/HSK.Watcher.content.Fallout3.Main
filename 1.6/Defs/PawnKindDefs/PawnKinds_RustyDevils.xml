<?xml version="1.0" encoding="utf-8"?>
<Defs>

   <PawnKindDef Abstract="True" Name="RustyDevilsBase">
    <race>Human</race>
    <defaultFactionType>RustyDevils</defaultFactionType>
    <backstoryFilters>
        <li>
            <categories>
			  <li>Offworld</li>
            <li>Outsider</li>
            <li>Raider</li>
             <li>Enclave</li>
            </categories>
        </li>
    </backstoryFilters>
    <backstoryCryptosleepCommonality>0.1</backstoryCryptosleepCommonality>
    <isFighter>true</isFighter>
    <chemicalAddictionChance>0.05</chemicalAddictionChance>
    <itemQuality>Normal</itemQuality>
    <invNutrition>2.5</invNutrition>
    <invFoodDef>MealFine</invFoodDef>
    <minGenerationAge>20</minGenerationAge>
    <maxGenerationAge>50</maxGenerationAge>
	<apparelColor>(100,100,100)</apparelColor>
    <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <gearHealthRange>
        <min>0.6</min>
        <max>1.8</max>
    </gearHealthRange>
    <specificApparelRequirements>
        <li>
            <bodyPartGroup>Torso</bodyPartGroup>
            <apparelLayer>Shell</apparelLayer>
        </li>
    </specificApparelRequirements>
    <disallowedTraits>
        <li>Brawler</li>
        <li>Pyromaniac</li>
    </disallowedTraits>
    <requiredWorkTags>
        <li>Violent</li>
    </requiredWorkTags>
    <techHediffsMoney>
        <min>8000</min>
        <max>15000</max>
    </techHediffsMoney>
    <techHediffsTags>
        <li>Advanced</li>
        <li>Futuristic</li>
        <li>Military</li>
    </techHediffsTags>
    <techHediffsChance>0.9</techHediffsChance>
    <techHediffsMaxAmount>8</techHediffsMaxAmount>
   
</PawnKindDef>

<!-- Enclave Trooper -->
<PawnKindDef Name="RustyDevilsTrooperBase" ParentName="RustyDevilsBase" Abstract="True">
    <label>Rusty mechanic</label>
    <combatPower>420</combatPower>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <gearHealthRange>
        <min>0.6</min>
        <max>1.8</max>
    </gearHealthRange>
    <apparelMoney>
        <min>12000</min>
        <max>18000</max>
    </apparelMoney>
    <apparelRequired>
		<li>Apparello_PipBoy</li>
        <li>Helmet_Welding</li>
    </apparelRequired>
    <apparelTags>
       <li>BanditsLight</li>
			<li>WoodenShield</li>
    </apparelTags>
    <weaponMoney>
        <min>2500</min>
        <max>4000</max>
    </weaponMoney>
    <weaponTags>
          <li>RF2</li>
    </weaponTags>
    <skills>
        <li>
            <skill>Shooting</skill>
            <range>6~18</range>
        </li>
    </skills>
    <initialWillRange>3~5</initialWillRange>
    <initialResistanceRange>15~22</initialResistanceRange>
    <modExtensions>
        <li Class="CombatExtended.LoadoutPropertiesExtension">
            <primaryMagazineCount>
                <min>5</min>
                <max>7</max>
            </primaryMagazineCount>
            <sidearms>
