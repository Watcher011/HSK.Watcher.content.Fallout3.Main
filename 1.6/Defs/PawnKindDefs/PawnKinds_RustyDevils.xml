                    <generateChance>0.2</generateChance>
                    <sidearmMoney>
                        <min>300</min>
                        <max>500</max>
                    </sidearmMoney>
                    <weaponTags>
                        <li>PlasmaPistol</li>
                    </weaponTags>
                    <magazineCount>
                        <min>2</min>
                        <max>4</max>
                    </magazineCount>
                </li>
            </sidearms>
        </li>
    </modExtensions>
</PawnKindDef>

<PawnKindDef ParentName="RustyDevilsTrooperBase">
    <defName>Rusty_mechanic</defName>
	<techHediffsRequired>
			<li>DeathAcidifier</li>
		</techHediffsRequired>
</PawnKindDef>

<PawnKindDef ParentName="RustyDevilsTrooperBase">
