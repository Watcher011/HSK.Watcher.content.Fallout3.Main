            <renderUtilityAsPack>true</renderUtilityAsPack>
        </wornGraphicData>
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <bodyPartGroups>
            <li>Waist</li>
        </bodyPartGroups>
        <layers>
               <li>Shell</li>
        </layers>
    </apparel>
	  <thingCategories>
            <li>LightUpperArmorCat</li>
            <li>SetMedical</li>
        </thingCategories>
        <recipeMaker>
            <researchPrerequisite>Apparel_C5</researchPrerequisite>
        </recipeMaker>
</ThingDef>
