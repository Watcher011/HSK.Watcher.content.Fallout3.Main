      </li>
    </modExtensions>
    
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>3.9</explosiveRadius>
        <explosiveDamageType>Watcher_MedicalFoam</explosiveDamageType>  <!-- БЕЗ _CE -->
        <wickTicks>0</wickTicks>
      </li>
    </comps>
  </ThingDef>
  
  
  
  
  
  
 <ThingDef ParentName="ApparelIndustrialBase">
    <defName>Watcher_Stimulantbackpack</defName>
    <label>Stimulant backpack</label>
    <description>Pre-war development for military personnel who can't even have a snack without a dose of stimulant. A built-in auto-injector in the straps delivers a stimulant at the first sign of the owner passing out.☠️ ABOUT OVERDOSE:
If the backpack decides you're doing badly twice — get ready to meet your ancestors. Three injections in a row turn a ranger into a trembling pile of meat that still has time to think: "Wait... was the 'cancel' button just for decoration?"</description>
    <graphicData>
        <texPath>Things/Apparel/Clothes/DoctorBrocade/Meditux</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>0.75</drawSize>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <tickerType>Normal</tickerType>
    <statBases>
        <WorkToMake>3500</WorkToMake>
        <Mass>0.8</Mass>
        <Bulk>2</Bulk>
        <WornBulk>1</WornBulk>
        <EquipDelay>2</EquipDelay>
        <Flammability>0.4</Flammability>
    </statBases>
      <stuffCategories>
            <li>HF</li>
            <li>Fabric</li>
        </stuffCategories>
        <costStuffCount>65</costStuffCount>
        <costList>
