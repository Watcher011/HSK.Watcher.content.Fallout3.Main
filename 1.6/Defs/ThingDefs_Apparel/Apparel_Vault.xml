			</tags>
			<defaultOutfitTags>
				<li>Worker</li>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<thingCategories>
			<li>FullBodySuitsCat</li>
		</thingCategories>
	</ThingDef>
	
	
