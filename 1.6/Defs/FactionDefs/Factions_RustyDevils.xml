<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<FactionDef ParentName="FactionBase">
    <defName>RustyDevils</defName>
    <label>rusty devils</label>
    <pawnSingular>rusty devil</pawnSingular>
    <pawnsPlural>rusty devils</pawnsPlural>
    <listOrderPriority>30</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxCountAtGameStart>1</maxCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>false</canSiege>
    <autoFlee>true</autoFlee>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Devil</leaderTitle>
    <earliestRaidDays>460</earliestRaidDays>
    <mustStartOneEnemy>true</mustStartOneEnemy>
    <naturalEnemy>true</naturalEnemy>
    <factionIconPath>World/WorldObjects/Expanding/RustyDevils</factionIconPath>
    <factionNameMaker>NamerFactionRustyDevils</factionNameMaker>
    <settlementNameMaker>NamerSettlementRustyDevils</settlementNameMaker>
    <techLevel>Spacer</techLevel>
    <colorSpectrum>
        <li>(1, 1, 1)</li>
    </colorSpectrum>
    <xenotypeSet>
        <xenotypeChances>
            <OE_Ghoul MayRequire="Ludeon.RimWorld.Biotech">0.13</OE_Ghoul>
        </xenotypeChances>
    </xenotypeSet>
    <allowedCultures>
        <li>Astropolitan</li>
    </allowedCultures>
    <disallowedMemes>
        <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Structure_TheistAbstract</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Proselytizer</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">HighLife</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Individualist</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">MaleSupremacy</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">FemaleSupremacy</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginChristian</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginIslamic</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginHindu</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginBuddhist</li>
    </disallowedMemes>
    <disallowedPrecepts>
        <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
    </disallowedPrecepts>
   <backstoryFilters>
    <li>
        <categories>
            <li>Offworld</li>
            <li>Outsider</li>
            <li>Raider</li>
        </categories>
    </li>
</backstoryFilters>
    <allowedArrivalTemperatureRange>-65~45</allowedArrivalTemperatureRange>
    <raidLootMaker>RustyDevilsRaidLootMaker</raidLootMaker>
    <raidLootValueFromPointsCurve>
        <points>
            <li>(0, 0)</li>
            <li>(50, 20)</li>
            <li>(100, 40)</li>
            <li>(200, 70)</li>
            <li>(500, 150)</li>
            <li>(1000, 250)</li>
            <li>(2000, 400)</li>
            <li>(5000, 800)</li>
            <li>(10000, 1400)</li>
        </points>
    </raidLootValueFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve>
        <points>
            <li>(400,200)</li>
            <li>(900,300)</li>
            <li>(100000,10000)</li>
        </points>
    </maxPawnCostPerTotalPointsCurve>
    <apparelStuffFilter>
        <categories>
            <li>Leathers</li>
        </categories>
        <thingDefs>
            <li>WoodPlank</li>
            <li>Cloth</li>
            <li>WoolMuffalo</li>
            <li>WoolDromedary</li>
            <li>WoolAlpaca</li>
            <li>HempCloth</li>
            <li>WoolSheep</li>
            <li>Bronze</li>
            <li>SteelBar</li>
            <li>DevilstrandCloth</li>
            <li>Kevlar</li>
            <li>Synthread</li>
            <li>Hyperweave</li>
            <li>FerrosiliconAlloy</li>
            <li>CupronickelAlloy</li>
            <li>Plasteel</li>
            <li>AlnicoAlloy</li>
            <li>StelliteAlloy</li>
        </thingDefs>
    </apparelStuffFilter>
    <pawnGroupMakers>
        <!-- Рейд с мехом (гарантированно) -->
        <li>
            <kindDef>Combat</kindDef>
            <commonality>100</commonality>
            <options>
                <Rusty_mechanic>10</Rusty_mechanic>
                <Rusty_mechanic_Advanced>6</Rusty_mechanic_Advanced>
                <Rusty_technician>5</Rusty_technician>
                <Rusty_technician_Advanced>3</Rusty_technician_Advanced>
            </options>
        </li>
        <!-- Settlement с мехом -->
        <li>
            <kindDef>Settlement</kindDef>
            <options>
               <Rusty_mechanic>10</Rusty_mechanic>
                <Rusty_mechanic_Advanced>6</Rusty_mechanic_Advanced>
                <Rusty_technician>5</Rusty_technician>
                <Rusty_technician_Advanced>3</Rusty_technician_Advanced>
            </options>
        </li>
    </pawnGroupMakers>
    <settlementTexturePath>World/WorldObjects/Expanding/RustyDevils</settlementTexturePath>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>52</configurationListOrderPriority>
</FactionDef>
<RulePackDef>
    <defName>NamerFactionRustyDevils</defName>
    <rulePack>
        <rulesStrings>
            <li>empire->RustyDevils</li>
        </rulesStrings>
    </rulePack>
</RulePackDef>
<RulePackDef>
    <defName>NamerSettlementRustyDevils</defName>
    <rulePack>
        <rulesStrings>
            <li>townend->RustyDevils dump East</li>
            <li>townend->RustyDevils dump North</li>
            <li>townend->RustyDevils dump South</li>
            <li>townend->RustyDevils dump West</li>
        </rulesStrings>
    </rulePack>
</RulePackDef>
<ThingSetMakerDef>
    <defName>RustyDevilsRaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
        <fixedParams>
            <filter>
                <thingDefs>
                    <li>Silver</li>
                    <li>MedicineIndustrial</li>
                    <li>MealSurvivalPack</li>
                    <li>HemogenPack</li>
                    <li>GoJuice</li>
                </thingDefs>
            </filter>
        </fixedParams>
    </root>
</ThingSetMakerDef>
</Defs>
