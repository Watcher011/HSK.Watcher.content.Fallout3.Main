<?xml version="1.0" encoding="utf-8" ?>
<Defs>
   <TaleDef>
    <defName>ListenedToRadio</defName>
    <label>listened to radio</label>
    <!-- Исправлено: используем Tale_SinglePawn -->
    <taleClass>Tale_SinglePawn</taleClass>
    <type>Volatile</type>
    <baseInterest>10</baseInterest>
    <colonistOnly>true</colonistOnly>
    <rulePack>
      <rulesStrings>
        <li>tale_noun->[PAWN_nameDef] listening to the radio</li>
        <li>tale_noun->[PAWN_nameDef] enjoying music from the radio</li>
        <li>image->[PAWN_nameFull] sitting near a radio [circumstance_group]</li>
        <li>image->[PAWN_nameFull] relaxing by a radio [circumstance_group]</li>
        <li>circumstance_phrase->with a look of contentment</li>
        <li>circumstance_phrase->while humming along</li>
        <li>circumstance_phrase->with a peaceful expression</li>
        <li>desc_sentence->[PAWN_pronoun] appears completely absorbed in the music.</li>
        <li>desc_sentence->The melody fills the room with warmth.</li>
      </rulesStrings>
    </rulePack>
  </TaleDef>
</Defs>
