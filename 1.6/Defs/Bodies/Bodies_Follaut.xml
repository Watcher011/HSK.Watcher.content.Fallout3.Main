  <!-- SporePlant Body Definition -->
  <BodyDef>
    <defName>SporePlant</defName>
    <label>SporePlant</label>
    <corePart>
      <def>SporeStalk</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>SporePlantStalk</li>
      </groups>
      <parts>
        <!-- Core bulb with vital organs -->
        <li>
          <def>SporeBulb</def>
          <customLabel>core bulb</customLabel>
          <coverage>0.15</coverage>
          <depth>Inside</depth>
        </li>
        
        <!-- Digestive system -->
        <li>
          <def>Stomach</def>
          <coverage>0.08</coverage>
          <depth>Inside</depth>
        </li>
        
        <!-- Circulatory/energy core -->
        <li>
          <def>Heart</def>
          <customLabel>pulsating core</customLabel>
          <coverage>0.06</coverage>
          <depth>Inside</depth>
        </li>
        
        <!-- Upper section - Head equivalent with Maw -->
        <li>
          <def>SporeBulb</def>
          <customLabel>cranial bulb</customLabel>
          <coverage>0.18</coverage>
          <height>Top</height>
          <groups>
            <li>HeadAttackTool</li>
          </groups>
          <parts>
            <!-- Maw with attack capability -->
            <li>
              <def>SporeMaw</def>
              <coverage>0.35</coverage>
              <groups>
                <li>SporePlantMaw</li>
                <li>Mouth</li>
                <li>Teeth</li>
              </groups>
              <parts>
                <li>
                  <def>Tongue</def>
                  <customLabel>sensory tendril</customLabel>
                  <coverage>0.25</coverage>
                </li>
              </parts>
            </li>
            
            <!-- Sensory organs -->
            <li>
              <def>Eye</def>
              <customLabel>primary ocular node</customLabel>
              <coverage>0.12</coverage>
            </li>
            <li>
              <def>Eye</def>
              <customLabel>secondary ocular node</customLabel>
              <coverage>0.08</coverage>
            </li>
            <li>
              <def>Ear</def>
              <customLabel>vibrational sensor</customLabel>
              <coverage>0.06</coverage>
            </li>
          </parts>
        </li>
        
        <!-- Movement tendrils -->
        <li>
          <def>SporeTendril</def>
          <customLabel>anterior tendril</customLabel>
          <coverage>0.07</coverage>
          <height>Bottom</height>
          <groups>
            <li>SporePlantTendril</li>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>SporeTendril</def>
          <customLabel>posterior tendril</customLabel>
          <coverage>0.07</coverage>
          <height>Bottom</height>
          <groups>
            <li>SporePlantTendril</li>
            <li>Legs</li>
          </groups>
        </li>
        <li>
          <def>SporeTendril</def>
          <customLabel>lateral tendril left</customLabel>
          <coverage>0.05</coverage>
          <height>Bottom</height>
          <groups>
            <li>SporePlantTendril</li>
          </groups>
        </li>
        <li>
          <def>SporeTendril</def>
          <customLabel>lateral tendril right</customLabel>
          <coverage>0.05</coverage>
          <height>Bottom</height>
          <groups>
            <li>SporePlantTendril</li>
          </groups>
        </li>
        
        <!-- Root system for anchoring -->
        <li>
          <def>SporeRoot</def>
          <customLabel>primary anchor root</customLabel>
          <coverage>0.04</coverage>
          <height>Bottom</height>
          <groups>
            <li>SporePlantRoot</li>
          </groups>
        </li>
        <li>
          <def>SporeRoot</def>
          <customLabel>secondary feeder root</customLabel>
          <coverage>0.04</coverage>
          <height>Bottom</height>
          <groups>
            <li>SporePlantRoot</li>
          </groups>
        </li>
        <li>
          <def>SporeRoot</def>
          <customLabel>tertiary stabilizing root</customLabel>
          <coverage>0.03</coverage>
          <height>Bottom</height>
          <groups>
            <li>SporePlantRoot</li>
          </groups>
        </li>
      </parts>
    </corePart>
  </BodyDef>
  
