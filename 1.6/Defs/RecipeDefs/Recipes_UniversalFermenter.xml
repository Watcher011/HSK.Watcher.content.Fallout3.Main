<?xml version="1.0" encoding="utf-8"?>
<Defs>


	
	<RecipeDef Name="Make_NukaColaBase" Abstract="True">
		<recipeUsers>
			<li>ColaBasin</li>
		</recipeUsers>
		
	
		<temperatureSafe>
			<min>-50</min>
			<max>60</max>
		</temperatureSafe>
		<temperatureIdeal>
			<min>-40</min>
			<max>30</max>
		</temperatureIdeal>
		<processDays>1</processDays>
		<speedBelowSafe>0.05</speedBelowSafe>
		<speedAboveSafe>0.5</speedAboveSafe>
		<sunFactor>
			<min>1</min>
			<max>1</max>
		</sunFactor>
		<rainFactor>
			<min>1</min>
			<max>1</max>
		</rainFactor>
		<snowFactor>
			<min>1</min>
			<max>1</max>
		</snowFactor>
		<windFactor>
			<min>1</min>
			<max>1</max>
		</windFactor>
	</RecipeDef>
	
	
	
	 <RecipeDef ParentName="Make_NukaColaBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_NukaCola</defName>
		<label>Make a Nuka Cola x3</label>
		<description>Nuka Cola x3.</description>
		<jobString>Creates a Nuka Cola.</jobString>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>FruitFoodRaw</li>
					</categories>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>CoffeeBeans</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>RawTato</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			
		</ingredients>
		<fixedIngredientFilter>
		    <categories>
				<li>FruitFoodRaw</li>
			</categories>
			<thingDefs>
				<li>CoffeeBeans</li>
				<li>RawTato</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<NukaCola>3</NukaCola>
		</products>
		<graphicSuffix>_NukaCola</graphicSuffix>
	</RecipeDef>
	
