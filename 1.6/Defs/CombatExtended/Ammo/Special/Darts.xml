<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<ThingCategoryDef>
		<defName>AmmoDarts</defName>
		<label>Syringer arrows</label>
		<parent>AmmoNeolithic</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberArrow</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<!-- Blowgun -->
	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_Syringerdart</defName>
		<label>Syringer darts</label>
		<ammoTypes>
			<Ammo_Dart_Syringer>Projectile_Dart_Syringer</Ammo_Dart_Syringer>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="AmmoArrowBase">
		<defName>Ammo_Dart_Syringer</defName>
		<label>Syringer dart</label>
		<description>A simple wooden dart with a barbed head coated in Syringer derived from plants and animal products.</description>
		<statBases>
			<Mass>0.014</Mass>
			<Bulk>0.04</Bulk>
			<Flammability>1</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Ammo/Tranquilizer</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
			    <drawSize>0.4</drawSize>
		</graphicData>
		<ammoClass>VenomArrow</ammoClass>
	</ThingDef>

	<!-- ================== Projectiles ================== -->

	<ThingDef ParentName="BaseArrowProjectile">
		<defName>Projectile_Dart_Syringer</defName>
		<label>Syringer dart</label>
		<graphicData>
			<texPath>Things/Projectile/Dart/Dart</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>16</speed>
			<damageDef>Tranquilizer</damageDef>
			<damageAmountBase>1.0</damageAmountBase>
			<armorPenetrationSharp>0.35</armorPenetrationSharp>
			<armorPenetrationBlunt>0.50</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeNeolithicBase">
		<defName>MakeAmmo_Dart_Syringer</defName>
		<label>make Syringer darts x10</label>
		<description>Craft 10 Syringer darts for use with blowguns.</description>
		<jobString>Making Syringer darts.</jobString>
		<workAmount>960</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>WoodLog</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>MedicineHerbal</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>WoodLog</li>
				<li>MedicineHerbal</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_Dart_Syringer>10</Ammo_Dart_Syringer>
		</products>
	</RecipeDef>

 
</Defs>