        </value>
      </li>
    </operations>
  </Operation>
  
  <!-- 3. Добавляем Radharvester в секцию редких уловов для обычных биомов -->
  <!-- (чтобы иногда появлялся даже в незагрязнённых водах как мутация) -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <!-- В редкие уловы для холодных биомов -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="BorealForest"]/fishTypes/freshwater_Uncommon</xpath>
