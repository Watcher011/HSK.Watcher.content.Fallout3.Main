      </li>
      
      <!-- В редкие уловы для умеренных биомов -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="TemperateForest"]/fishTypes/freshwater_Uncommon</xpath>
        <value>
          <Fish_Radharvester>0.08</Fish_Radharvester>
        </value>
      </li>
      
      <!-- В редкие уловы для тропиков -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="TropicalRainforest"]/fishTypes/freshwater_Uncommon</xpath>
        <value>
          <Fish_Radharvester>0.05</Fish_Radharvester>
