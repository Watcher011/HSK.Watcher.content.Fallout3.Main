		  <!-- Патч для Fish_ThreeCrawler - добавляется в обычные водные биомы (озера, реки, болота) -->
    <Operation Class="PatchOperationSequence">
    <operations>
      <!-- Лес -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="TemperateForest"]/fishTypes/freshwater_Common</xpath>
        <value>
          <Fish_ThreeCrawler>0.7</Fish_ThreeCrawler>
        </value>
      </li>
      
      <!-- Тайга/Бореальный лес -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="BorealForest"]/fishTypes/freshwater_Common</xpath>
        <value>
          <Fish_ThreeCrawler>0.5</Fish_ThreeCrawler>
        </value>
      </li>
      
      <!-- Тропический лес -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="TropicalRainforest"]/fishTypes/freshwater_Common</xpath>
        <value>
          <Fish_ThreeCrawler>1.0</Fish_ThreeCrawler>
        </value>
      </li>
      
      <!-- Пустыня (редко, только в оазисах) -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="Desert"]/fishTypes/freshwater_Common</xpath>
        <value>
          <Fish_ThreeCrawler>0.3</Fish_ThreeCrawler>
        </value>
      </li>
      
      <!-- Аридный кустарник -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="AridShrubland"]/fishTypes/freshwater_Common</xpath>
        <value>
          <Fish_ThreeCrawler>0.6</Fish_ThreeCrawler>
        </value>
      </li>
    </operations>
  </Operation>
  
  <!-- 2. Холодные и экстремальные биомы (меньше шанс) -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <!-- Тундра -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/BiomeDef[defName="Tundra"]/fishTypes/freshwater_Common</xpath>
